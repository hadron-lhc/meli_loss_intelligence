# Local development defaults. Copy to .env before running the stack.
# Never commit .env or real credentials.

POSTGRES_USER=loss_app
POSTGRES_PASSWORD=loss_app_dev_password
POSTGRES_DB=loss_intelligence
POSTGRES_PORT=5433

DATABASE_URL=postgresql+psycopg://loss_app:loss_app_dev_password@localhost:5433/loss_intelligence
TEST_DATABASE_URL=postgresql+psycopg://loss_app:loss_app_dev_password@localhost:5433/loss_intelligence_test
TEST_ADMIN_DATABASE_URL=postgresql+psycopg://loss_app:loss_app_dev_password@localhost:5433/postgres

APP_ENV=local
LOG_LEVEL=INFO
DB_ECHO=false
